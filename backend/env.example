# Bu dosyayı .env adıyla kopyalayın ve değerleri doldurun. .env dosyası repoya EKLENMEZ.

# --- Zorunlu ---------------------------------------------------------------
# Google AI Studio / Gemini API anahtarı
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY
# Firebase Console > Proje ayarları > Proje kimliği (frontend'deki VITE_FIREBASE_PROJECT_ID ile aynı)
FIREBASE_PROJECT_ID=your-firebase-project-id

# --- Veritabanı (ZORUNLU) ------------------------------------------------------
# PostgreSQL bağlantı adresi. Yerel geliştirme için Neon'da ayrı bir "dev" branch'i ya da
# bilgisayarınızdaki PostgreSQL'i kullanın; canlı veritabanının adresini burada denemeyin.
#   Neon:  postgresql://kullanici:sifre@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
#   Yerel: postgresql://postgres:sifre@localhost:5432/akilli_servis
DATABASE_URL=
# Uyuyan veritabanı uyanırken bağlantı kaç kez denensin / bağlantı zaman aşımı (sn)
# DB_BAGLANTI_DENEME=3
# DB_BAGLANTI_ZAMAN_ASIMI=10

# --- Roller ----------------------------------------------------------------------
# Bu e-postalar ilk girişte otomatik olarak "yonetici" rolü alır (virgülle ayırın).
ADMIN_EMAILS=

# --- Yapay zekâ ve kota ----------------------------------------------------------
GEMINI_AI_MODELI=gemini-3.8-flash
# Model kapatılırsa sırayla denenecek yedekler (virgülle)
# GEMINI_AI_MODELLERI=gemini-3.5-flash-lite
GEMINI_MODEL_SIRASI=gemini-3.8-flash,gemini-3.5-flash-lite
# Kullanıcı başına günlük Gemini çağrısı (önbellekten dönen sonuçlar sayılmaz)
GUNLUK_ANALIZ_LIMITI=15
# Gemini için toplam bekleme süresi (sn). Aşılırsa YOLO sonucu yine döner.
GEMINI_TOPLAM_SURE=90
# Tek bir Gemini denemesinin süre sınırı (sn). Aşılırsa beklemeden yedek modele geçilir.
GEMINI_ISTEK_ZAMAN_ASIMI=40
FIYAT_GOSTER=false
"Not: Buradaki limitleri değişebilirsiniz"
# --- YOLO ----------------------------------------------------------------------------
# PARCA_MODEL_YOLU=models/parts/parts_best.pt
# HASAR_MODEL_YOLU=models/damage/damage_best.pt
PARCA_GUVEN_ESIGI=0.25
HASAR_GUVEN_ESIGI=0.25

# --- Bildirimler -----------------------------------------------------------------
# Bakım / poliçe hatırlatmalarının kaç saatte bir taranacağı (0 = kapalı)
BILDIRIM_TARAMA_SAAT=6

# --- CORS ------------------------------------------------------------------------
# Frontend adresleri (virgülle). Canlıda Vercel adresinizi ekleyin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app


